<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="16" styleClass="page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fu.cinema.desktop.controller.GenreController">
    <VBox spacing="8" HBox.hgrow="ALWAYS">
        <Label text="DANH SÁCH THỂ LOẠI" styleClass="page-title"/>
        <TableView fx:id="table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colName" text="Tên thể loại" prefWidth="180"/>
                <TableColumn fx:id="colDesc" text="Mô tả" prefWidth="320"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

    <VBox fx:id="formBox" spacing="10" prefWidth="300" styleClass="form-card">
        <Label text="Thông tin thể loại" styleClass="section-title"/>
        <Label text="Tên thể loại *"/>
        <TextField fx:id="tfName" promptText="Nhập tên thể loại"/>
        <Label text="Mô tả"/>
        <TextArea fx:id="taDesc" promptText="Mô tả ngắn gọn" prefRowCount="4" wrapText="true"/>
        <HBox spacing="8">
            <Button fx:id="btnSave" text="Lưu" onAction="#onSave" styleClass="primary" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button text="Thêm mới" onAction="#onNew"/>
            <Button fx:id="btnDelete" text="Xoá" onAction="#onDelete" styleClass="danger"/>
        </HBox>
    </VBox>
</HBox>
