<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14" styleClass="page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fu.cinema.desktop.controller.MovieController">

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="DANH SÁCH PHIM" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblCount" styleClass="text-muted"/>
        <Button text="+ Thêm phim" onAction="#onAdd" styleClass="primary"/>
        <Button text="Xoá" onAction="#onDelete" styleClass="danger"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="tfSearch" promptText="Tìm theo tên phim..." prefWidth="250"/>
        <ComboBox fx:id="cbGenre" prefWidth="180" promptText="Tất cả thể loại"/>
        <ComboBox fx:id="cbStatus" prefWidth="170" promptText="Tất cả trạng thái"/>
        <ComboBox fx:id="cbSort" prefWidth="170"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colTitle" text="Tên phim" prefWidth="260"/>
            <TableColumn fx:id="colGenre" text="Thể loại" prefWidth="140"/>
            <TableColumn fx:id="colDuration" text="Thời lượng" prefWidth="110"/>
            <TableColumn fx:id="colRelease" text="Ngày phát hành" prefWidth="130"/>
            <TableColumn fx:id="colAge" text="Độ tuổi" prefWidth="100"/>
            <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="120"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER">
        <Pagination fx:id="pagination" maxPageIndicatorCount="7"/>
    </HBox>
</VBox>

